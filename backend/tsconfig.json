{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext", // Garante suporte a import/export nativo
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDirs": ["src"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}
